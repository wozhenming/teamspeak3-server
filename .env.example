# ============================================================================
# docker compose 配置模板：复制为 .env 后按需修改
#   cp .env.example .env
# 修改后执行：docker compose up -d
# ============================================================================

# --- 管理面板 ---
PANEL_USERNAME=admin
# 面板登录密码（务必修改！）
PANEL_PASSWORD=admin123
# 会话签名密钥（务必修改！生成：openssl rand -hex 32）
SESSION_SECRET=please-change-me
# 面板端口
PANEL_PORT=3000

# --- TeamSpeak 3 服务器 ---
# 语音 / 文件传输 / ServerQuery 端口
TS_PORT_VOICE=9987
TS_PORT_FILE=30033
TS_PORT_QUERY=10011

# serveradmin 查询密码（TS3 无 API Key 概念，一切管理经 ServerQuery）
# 留空则使用首次启动自动生成并打印在容器日志里的密码；
# 在「部署管理」页可查看/提取，也可在面板点歌页填写（持久化到面板数据卷）。
TS_QUERY_ADMIN_PASSWORD=

# 机器人要加入的频道若设了密码，填这里（点歌机器人与点歌助手都会用它加入该频道）
TS_CHANNEL_PASSWORD=

# --- 点歌机器人（可选） ---
# 面板后端代理点歌服务的地址（容器内指向 music 服务，一般无需修改）
# MUSIC_BASE_URL=http://music:3200
# 网易云 API 内网地址（指向 api-enhanced，一般无需修改）
# NCMAPI_BASE=http://neteasemusic:3000
# 点歌服务监听端口
# MUSIC_BOT_PORT=3200

# --- 点歌机器人 → TeamSpeak 推流（开箱即用，一般无需修改） ---
# TS3AudioBot 语音引擎地址（容器内网地址，一般无需修改）
# TS3AB_URL=http://ts3audiobot:58913
# 部署频道列表（逗号分隔频道路径；也可在面板点歌页配置并持久化）
# TS3AB_CHANNELS=默认频道
# 点歌机器人昵称（多频道自动加「·频道名」后缀；可在面板点歌页配置）
# TS3AB_BOT_NICKNAME=点歌机器人
# 电台流地址：TS3AudioBot 拉流地址（内网即可，music 会自动把主机名解析成 IP）
# STREAM_BOT_URL=http://music:3200/api/stream
# 电台流对外收听地址（面板展示用，可选）：填服务器公网 IP/域名
# 例：STREAM_PUBLIC_HOST=8.8.8.8 → http://8.8.8.8:3200/api/stream
# STREAM_PUBLIC_URL=
# STREAM_PUBLIC_HOST=
# 音频流访问令牌（防公网随意收听；面板点歌页可开关并重新生成）
STREAM_TOKEN=ts3bot
# 电台流对外端口
MUSIC_STREAM_PORT=3200
