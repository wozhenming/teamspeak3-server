# ============================================================
# TeamSpeak 3 管理面板 配置模板
# 复制为 .env 后按需修改：  cp .env.example .env
# ============================================================

# --- 面板自身 ---
# 面板监听地址与端口
HOST=127.0.0.1
PORT=3000

# 面板登录账号（面板自带认证，与 TeamSpeak 无关）
PANEL_USERNAME=admin
PANEL_PASSWORD=admin123

# 会话签名密钥（务必改为随机长字符串！可用: openssl rand -hex 32）
SESSION_SECRET=please-change-me

# --- TeamSpeak 3 ServerQuery ---
# ServerQuery 地址（原始 TCP，默认本机 10011 端口）
TSSERVER_QUERY_HOST=127.0.0.1
TSSERVER_QUERY_PORT=10011
# serveradmin 查询密码（也可在「部署管理」页面填入，保存后立即生效）
TSSERVER_QUERY_PASSWORD=

# 默认管理的虚拟服务器 ID
TSSERVER_DEFAULT_SID=1

# 部署管理：docker-compose.yml 生成目录（默认项目 deploy/ 目录）
# DEPLOY_DIR=/opt/ts3/deploy

# --- 点歌机器人 ---
# music 服务内网地址（后端代理）
MUSIC_BASE_URL=http://music:3200

# --- 运行模式 ---
# container=由项目根目录 docker-compose 管理（部署页操作主机 Docker 容器）
# PANEL_RUN_MODE=container
# TS3 容器名（容器化模式下读取日志/凭证、快捷启停）
# TSSERVER_CONTAINER_NAME=teamspeak-server
# 面板配置持久化文件（容器内指向数据卷）
# PANEL_ENV_FILE=/app/config/panel.env
